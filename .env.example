# Infrastructure
NODE_ENV=development
DATABASE_URL=postgresql://affiliate:affiliate@postgres:5432/affiliate_autopilot
REDIS_URL=redis://redis:6379
PORT=3000
LOG_LEVEL=info

# Safe defaults: no paid generation or real publishing without explicit opt-in.
PRODUCT_PROVIDER=manual
CONTENT_PROVIDER=template
SNAPGEN_MODE=mock
PUBLISH_MODE=mock
METRICS_MODE=disabled
NOTIFICATION_MODE=log
ALLOW_PAID_OPERATIONS=false
ALLOW_REAL_PUBLISHING=false
AUTO_SEED_DEMO=false
AUTO_PUBLISH_AFTER_QA=false

# SnapGen middleware (C:\Dev\Middleware-snapgen). Never commit secrets.
SNAPGEN_BASE_URL=http://host.docker.internal:3001
SNAPGEN_API_KEY=
SNAPGEN_POLL_SECONDS=10
SNAPGEN_MODEL=omni-flash
SNAPGEN_DURATION_SECONDS=8
SNAPGEN_ASPECT_RATIO=9:16
SNAPGEN_RESOLUTION=1080p

# Instagram Graph API
META_GRAPH_VERSION=v23.0
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8088/api/integrations/tiktok/callback/
TIKTOK_POLL_SECONDS=5
TIKTOK_PUBLISH_TIMEOUT_SECONDS=300
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=http://localhost:8088/api/integrations/youtube/callback/
YOUTUBE_PRIVACY_STATUS=public
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=https://affiliate-autopilot-achadinhos.woinsilva.chatgpt.site/
INSTAGRAM_CONTAINER_POLL_SECONDS=5
INSTAGRAM_CONTAINER_TIMEOUT_SECONDS=300
INSTAGRAM_SHARE_TO_FEED=true

# Resend reports and alerts
RESEND_API_KEY=
EMAIL_FROM=Affiliate Autopilot <onboarding@resend.dev>
EMAIL_TO=
DAILY_REPORT_CRON=0 21 * * *
WEEKLY_REPORT_CRON=0 20 * * 0
TIMEZONE=America/Sao_Paulo

# Scheduler
DISCOVERY_CRON=0 */6 * * *
ANALYTICS_CRON=15 */6 * * *
